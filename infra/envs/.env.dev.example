# ==============================================================================
# PyIngestKit Development Environment Example (.env.dev.example)
# Reflète pyingest.yml.dev (Local-First: Filesystem + SQLite)
# ==============================================================================

# Sélection automatique du profil de configuration dev
PYINGEST_CONFIG=pyingest.yml.dev

# Espace de travail local pour les artéfacts et l'état SQLite
PYINGEST_WORKSPACE=.pyingest

# ------------------------------------------------------------------------------
# Notes :
# - Aucun serveur PostgreSQL ni bucket S3 n'est requis en développement local.
# - Les métadonnées sont écrites automatiquement dans :
#     .pyingest/state/pyingest.sqlite3
# - Les artéfacts sont stockés directement dans :
#     .pyingest/artifacts/
# - Les journaux d'exécution sont écrits dans :
#     .pyingest/logs/pyingest.log
# ------------------------------------------------------------------------------
