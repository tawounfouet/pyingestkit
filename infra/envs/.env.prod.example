# ==============================================================================
# PyIngestKit Production Environment Example (.env.prod.example)
# Reflète pyingest.yml.prod (Enterprise: PostgreSQL + AWS S3 / Cloudflare R2)
# ==============================================================================

# Sélection automatique du profil de configuration production
PYINGEST_CONFIG=pyingest.yml.prod

# PostgreSQL DSN de Production (Métadonnées & Cible Warehouse)
PYINGEST_DATABASE_URL=postgresql://<prod_user>:<prod_password>@<prod_host>:5432/<prod_db>
PYINGEST_TARGET_DATABASE_URL=postgresql://<prod_user>:<prod_password>@<prod_host>:5432/<prod_warehouse_db>

# Credentials et Endpoint Stockage d'Artéfacts S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your_production_access_key_id
AWS_SECRET_ACCESS_KEY=your_production_secret_access_key
AWS_DEFAULT_REGION=auto

# Laisser vide pour AWS S3 natif, ou renseigner pour Cloudflare R2 / S3-compatible :
# PYINGEST_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
