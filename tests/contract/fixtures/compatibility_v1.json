  "policy": {
    "public_exports": "Existing stable-candidate exports may not be removed or renamed without an explicit breaking-change decision before V1.0 RC1.",
    "dataclass_fields": "Existing field names and order are compatibility-sensitive. Additive fields must be optional or defaulted and require an intentional contract update.",
    "enum_values": "Existing enum names and serialized values are immutable compatibility data. Additions are governed because callers may use exhaustive matching.",
    "abstract_contracts": "Existing abstract method sets are frozen. New abstract methods are breaking; additive concrete methods are preferred.",
    "persistent_json": "Existing keys and meanings are preserved. Additive keys are allowed within a schema version; incompatible semantic changes require a schema-version bump and an upgrade path.",
    "physical_metadata_schema": "SQL table/layout details remain internal. Logical record and capability contracts are the V1 compatibility boundary."
