# Database DSN for PyIngestKit PostgreSQL target
PYINGEST_TARGET_DATABASE_URL=postgresql://postgres@localhost:5432/pyingest

# Database DSN for PyIngestKit PostgreSQL metadata backend
PYINGEST_DATABASE_URL=postgresql://postgres@localhost:5432/pyingest

# Database DSN for integration tests (pytest)
PYINGEST_TEST_POSTGRES_DSN=postgresql://postgres@localhost:5432/pyingest

# Cloudflare R2 / S3-compatible Object Storage Credentials & Endpoint
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_DEFAULT_REGION=auto
PYINGEST_S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# PyPI Deployment Credentials
TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-your_pypi_token_here

