runtime:
  workspace: .pyingest
  fixture_mode: false
  parameters: {}

metadata:
  backend: sqlite
  sqlite:
    path: null
  postgres:
    dsn_env: PYINGEST_DATABASE_URL

logging:
  level: INFO
  format: rich
  console: true
  file:
    enabled: true
    path: .pyingest/logs/pyingest.log
    level: DEBUG
    format: json
    max_bytes: 10000000
    backup_count: 5
