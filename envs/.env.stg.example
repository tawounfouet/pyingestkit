# ==============================================================================
# PyIngestKit Staging Environment Example (.env.stg.example)
# Reflète pyingest.yml.stg (Docker Compose: PostgreSQL + MinIO)
# ==============================================================================

# Sélection automatique du profil de configuration staging
PYINGEST_CONFIG=pyingest.yml.stg

# PostgreSQL DSN (Métadonnées & Cible Warehouse sous Docker)
PYINGEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pyingest
PYINGEST_TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pyingest

# MinIO Object Storage (API sur le port 9000, Console sur 9001)
PYINGEST_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
