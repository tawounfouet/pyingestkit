# ==============================================================================
# PyIngestKit Staging Environment Example (.env.stg.example)
# Reflète pyingest.yml.stg (Docker Compose: PostgreSQL + MinIO)
# ==============================================================================

# Sélection automatique du profil de configuration staging
PYINGEST_CONFIG=pyingest.yml.stg

# Credentials pour Docker Compose & Services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pyingest

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# PostgreSQL DSN (Métadonnées & Cible Warehouse sous Docker)
PYINGEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
PYINGEST_TARGET_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# MinIO Object Storage (API sur le port 9000, Console sur 9001)
PYINGEST_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1

